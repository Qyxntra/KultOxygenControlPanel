{
  "name": "kult-oxygen-control-panel",
  "version": "0.2.13",
  "description": "Kult Oxygen Control Panel - Advanced Mouse Tuning Utility",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Qyxntra",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.glab.kultoxygen.controlpanel",
    "productName": "KultOxygenControlPanel",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "rawaccel",
        "to": "rawaccel",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
