{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KultOxygenControlPanel",
  "version": "0.2.0",
  "identifier": "com.glab.kultoxygen.controlpanel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8000/index.html"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kult Oxygen Control Panel",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "rawaccel/**/*"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/Qyxntra/KultOxygenControlPanel/main/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCODY3M0I1NjE4NTlFNzUKUldSMW5vVmh0WE9HTytxQ0lvaWJTcWhUNmVqUkw5aENVL3pyYXR1YzZIUXI2WEZnYXVGbGowMUcK"
    }
  }
}
